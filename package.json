{
  "name": "rea-office",
  "productName": "Rea Office",
  "version": "0.1.0",
  "description": "An Office-style desktop suite (documents, spreadsheets, presentations) with Claude built in.",
  "private": true,
  "license": "MIT",
  "author": "Amit",
  "repository": {
    "type": "git",
    "url": "https://github.com/amitran4812/Reverse-Engineer_365.git"
  },
  "main": "main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "test": "node --test \"test/*.test.*\"",
    "dist": "node build.mjs && electron-builder --publish never",
    "dist:win": "node build.mjs && electron-builder --win --publish never",
    "dist:mac": "node build.mjs && electron-builder --mac --publish never",
    "dist:linux": "node build.mjs && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-highlight": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-text-align": "^3.32.1",
    "@tiptap/extension-text-style": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fast-formula-parser": "^1.0.19",
    "jszip": "^3.10.2"
  },
  "build": {
    "appId": "tools.rea.office",
    "productName": "Rea Office",
    "copyright": "Copyright © 2026 Amit",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "common/**",
      "dist/**/*.{html,js,css,txt}",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Document",
        "description": "Document (.docx)",
        "role": "Editor"
      },
      {
        "ext": "xlsx",
        "name": "Workbook",
        "description": "Workbook (.xlsx)",
        "role": "Editor"
      },
      {
        "ext": "csv",
        "name": "CSV file",
        "description": "Comma-separated values",
        "role": "Editor"
      },
      {
        "ext": "reaslides",
        "name": "Rea Slides presentation",
        "description": "Presentation",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rea Office",
      "artifactName": "Rea-Office-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Amit"
    }
  },
  "homepage": "https://github.com/amitran4812/Reverse-Engineer_365#readme"
}
