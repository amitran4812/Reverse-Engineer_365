    "fast-formula-parser": "^1.0.19",
    "fflate": "^0.8.3",
    "hyparquet": "^1.32.0",
    "hyparquet-compressors": "^1.1.2",
    "hyparquet-writer": "^0.18.0",
    "mathjax-full": "^3.2.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "build": {
    "appId": "tools.rea.office",
    "productName": "Work",
    "copyright": "Copyright © 2026 Amit",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "common/**",
      "dist/**/*.{html,js,css,txt,woff2}",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Work",
      "artifactName": "Work-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Work records voice notes in Write when you ask it to."
      },
      "icon": "build/icon.png",
      "fileAssociations": [
        {
          "ext": [
            "docx",
            "odt",
            "rtf"
          ],
          "name": "Write document",
          "role": "Editor"
        },
        {
          "ext": [
            "xlsx",
            "xlsm",
            "xls",
            "ods",
            "csv",
            "xlsb",
            "numbers"
          ],
          "name": "Plot workbook",
          "role": "Editor"
        },
        {
          "ext": [
            "reaslides",
            "pptx",
            "odp",
            "ppsx",
            "potx"
          ],
          "name": "Present presentation",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Amit",
      "fileAssociations": [
        {
          "ext": [
            "docx",
            "odt",
            "rtf"
          ],
          "name": "Write document",
          "role": "Editor"
        },
        {
          "ext": [
            "xlsx",
            "xlsm",
            "xls",
            "ods",
            "csv",
            "xlsb"
          ],
          "name": "Plot workbook",
          "role": "Editor"
        },
        {
          "ext": [
            "reaslides",
            "pptx",
            "odp",
            "ppsx",
            "potx"
          ],
          "name": "Present presentation",
          "role": "Editor"
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/apps",
        "to": "icons",
        "filter": [
          "*.ico"
        ]
      },
      {
        "from": "build/tectonic",
        "to": "tectonic",
        "filter": [
          "**/*",
          "!VERSION",
          "!WARM"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "amitran4812",
        "repo": "Reverse-Engineer_365",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/amitran4812/Reverse-Engineer_365#readme"
}
