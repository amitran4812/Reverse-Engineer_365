{
  "name": "rea-office",
  "productName": "Work",
  "version": "0.2.43",
  "description": "An Office-style desktop suite (documents, spreadsheets, presentations) with Claude built in.",
  "private": true,
  "license": "MIT",
  "author": "Amit",
  "repository": {
    "type": "git",
    "url": "https://github.com/amitran4812/Reverse-Engineer_365.git"
  },
  "main": "main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "test": "node --test \"test/*.test.*\"",
    "dist": "node build.mjs && node scripts/fetch-tectonic.mjs --warm && electron-builder --publish never",
    "dist:win": "node build.mjs && node scripts/fetch-tectonic.mjs --warm --required && electron-builder --win --publish never",
    "dist:mac": "node build.mjs && node scripts/fetch-tectonic.mjs --warm && electron-builder --mac --publish never",
    "dist:linux": "node build.mjs && node scripts/fetch-tectonic.mjs --warm && electron-builder --linux --publish never",
    "tectonic": "node scripts/fetch-tectonic.mjs --warm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@e965/xlsx": "0.20.3",
    "@xmldom/xmldom": "^0.8.15",
    "docx": "^9.15.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "isomorphic-git": "^1.44.11",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "pptxgenjs": "^4.0.1"
  },
