{
  "name": "rea-office",
  "productName": "Work",
  "version": "0.2.1",
  "description": "An Office-style desktop suite (documents, spreadsheets, presentations) with Claude built in.",
  "private": true,
  "license": "MIT",
  "author": "Amit",
  "repository": {
    "type": "git",
    "url": "https://github.com/amitran4812/Reverse-Engineer_365.git"
  },
  "main": "main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node build.mjs && electron .",
    "test": "node --test \"test/*.test.*\"",
    "dist": "node build.mjs && electron-builder --publish never",
    "dist:win": "node build.mjs && electron-builder --win --publish never",
    "dist:mac": "node build.mjs && electron-builder --mac --publish never",
    "dist:linux": "node build.mjs && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@e965/xlsx": "0.20.3",
    "@xmldom/xmldom": "^0.8.15",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-highlight": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-text-align": "^3.32.1",
    "@tiptap/extension-text-style": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fast-formula-parser": "^1.0.19"
  },
  "build": {
    "appId": "tools.rea.office",
    "productName": "Work",
    "copyright": "Copyright © 2026 Amit",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "common/**",
      "dist/**/*.{html,js,css,txt}",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Work",
      "artifactName": "Work-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "fileAssociations": [
        {
          "ext": [
            "docx",
            "odt"
          ],
          "name": "Write document",
          "role": "Editor"
        },
        {
          "ext": [
            "xlsx",
            "xlsm",
            "xls",
            "ods",
            "csv"
          ],
          "name": "Plot workbook",
          "role": "Editor"
        },
        {
          "ext": [
            "reaslides",
            "pptx",
            "odp"
          ],
          "name": "Present presentation",
          "role": "Editor"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Amit",
      "fileAssociations": [
        {
          "ext": [
            "docx",
            "odt"
          ],
          "name": "Write document",
          "role": "Editor"
        },
        {
          "ext": [
            "xlsx",
            "xlsm",
            "xls",
            "ods",
            "csv"
          ],
          "name": "Plot workbook",
          "role": "Editor"
        },
        {
          "ext": [
            "reaslides",
            "pptx",
            "odp"
          ],
          "name": "Present presentation",
          "role": "Editor"
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/apps",
        "to": "icons",
        "filter": [
          "*.ico"
        ]
      }
    ]
  },
  "homepage": "https://github.com/amitran4812/Reverse-Engineer_365#readme"
}
